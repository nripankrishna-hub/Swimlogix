# ---------- Server ----------
NODE_ENV=development
PORT=4000
CORS_ORIGIN=*

# ---------- Database ----------
MONGO_URI=mongodb://127.0.0.1:27017/swimlogix

# ---------- JWT ----------
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-too-in-production
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# ---------- OTP (provider: mock | msg91) ----------
OTP_PROVIDER=mock
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
# When true the generated OTP is returned in the API response (dev/staging only)
OTP_DEV_EXPOSE=true
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# ---------- Cloudinary (logo / media storage) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=swimlogix

# ---------- Firebase Cloud Messaging ----------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------- SuperAdmin bootstrap (used by `npm run seed:superadmin`) ----------
SUPERADMIN_NAME=Platform Owner
SUPERADMIN_PHONE=9999999999
SUPERADMIN_PASSWORD=SuperAdmin@123
